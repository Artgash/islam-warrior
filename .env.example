# =====================================================================
# ISLAM WARRIOR — environment
#
# Copy to .env.local and fill in. Every value is OPTIONAL: with none of
# them the app runs in local mode, storing everything in the browser.
# Add them to enable cloud sync, real accounts, guild chat and true
# leaderboards.
# =====================================================================

# --- Supabase (frontend) ---------------------------------------------
# Project Settings -> API -> Project URL / anon public key.
# The anon key is safe to ship: row-level security is what protects data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Optional -------------------------------------------------------
VITE_APP_NAME=ISLAM WARRIOR
# Set to "true" once Google OAuth is configured in Supabase Auth.
VITE_ENABLE_GOOGLE_AUTH=false


# =====================================================================
# Edge function secrets — set with `supabase secrets set`, NEVER here
# and never with a VITE_ prefix (that would ship them to the browser).
# =====================================================================
#
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
#
# SUPABASE_URL and SUPABASE_ANON_KEY are injected automatically by the
# Supabase runtime; only the service-role key must be set by hand.
#
# The service-role key bypasses row-level security. It authorises the
# scheduled functions (weekly-reset, season-rollover, anti-cheat-scan,
# guild-war-matchmake, apply-rank-decay) and the authoritative writes in
# complete-habit. Treat it like a root password.
